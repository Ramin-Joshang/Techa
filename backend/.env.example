# ==============================================================================
# TECHA 2.0 — BACKEND WORKSPACE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `backend/.env` or rely on the root `.env` loaded via PM2.
# ==============================================================================

# Node runtime mode ('production' | 'development' | 'test')
NODE_ENV=production

# Internal TCP listener port for Express (default: 5000)
API_PORT=5000

# Internal network interface binding (default: 127.0.0.1 for loopback security)
API_HOST=127.0.0.1

# Canonical public API origin for OpenAPI/Swagger documentation
CANONICAL_API_URL=https://techa.ir

# Flag to enable Swagger UI and OpenAPI documentation
SWAGGER_ENABLED=true

# MongoDB Atlas connection string (MANDATORY in production)
MONGODB_URI=mongodb+srv://techa_user:REPLACE_WITH_STRONG_PASSWORD@cluster0.abcde.mongodb.net/techa_production?retryWrites=true&w=majority

# Primary frontend origin
FRONTEND_ORIGIN=https://techa.ir

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://techa.ir,https://www.techa.ir,http://localhost:3000,http://127.0.0.1:3000

# Number of trusted proxy hops behind IIS ARR (typically 1 on loopback)
TRUST_PROXY_HOPS=1

# Logging level ('fatal', 'error', 'warn', 'info', 'debug', 'trace')
LOG_LEVEL=info
