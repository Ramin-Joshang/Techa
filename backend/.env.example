# ==============================================================================
# TECHA 2.0 — BACKEND SERVICE ENVIRONMENT TEMPLATE (backend/.env.example)
# ==============================================================================
# برای اجرا روی سرور مستقل یا PM2، این فایل را به backend/.env کپی و تکمیل کنید.
# ==============================================================================

# --- Server & Network ---
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3500
CANONICAL_API_URL=https://techa.ir
FRONTEND_ORIGIN=https://techa.ir
CORS_ORIGINS=https://techa.ir,https://www.techa.ir,http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=true
LOG_LEVEL=info

# --- MongoDB Atlas Connection ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/techa_prod?retryWrites=true&w=majority

# --- JWT & Cookie Security ---
# حداقل ۳۲ کاراکتر تصادفی تولید کنید (مثلاً: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ISSUER=techa.ir
JWT_AUDIENCE=techa-platform
JWT_ACCESS_TTL_SECONDS=600
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# --- Kavenegar OTP Configuration ---
AUTH_OTP_ENABLED=true
KAVENEGAR_API_KEY=your_kavenegar_api_key_here
# نام دقیق الگوی تاییدشده در پنل کاوه‌نگار (با توکن %token)
KAVENEGAR_VERIFY_TEMPLATE=techa-otp
KAVENEGAR_REGISTER_TEMPLATE=techa-register
KAVENEGAR_LOGIN_TEMPLATE=techa-otp
KAVENEGAR_PASSWORD_RESET_TEMPLATE=techa-reset
OTP_HASH_SECRET=replace_with_a_unique_otp_hmac_secret_at_least_32_characters
OTP_CODE_DIGITS=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=10

# --- Kavenegar Live Verification Test (فقط برای تست دستی، در سرور false بگذارید) ---
KAVENEGAR_LIVE_TEST_ENABLED=false
KAVENEGAR_LIVE_TEST_RECEPTOR=

# --- CMS Media Storage & Next.js Cache Revalidation ---
TECHA_MEDIA_STORAGE_ROOT=./storage/media
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_DOCUMENT_BYTES=52428800
MEDIA_MAX_VIDEO_BYTES=209715200
FRONTEND_INTERNAL_URL=http://127.0.0.1:3000
CACHE_REVALIDATION_SECRET=replace_with_a_different_random_revalidation_secret_32_chars

# --- Optional Initial Super Admin Bootstrap Script (npm run auth:bootstrap-admin) ---
# BOOTSTRAP_ADMIN_PHONE=09120000000
# BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithStrongPassword123!
# BOOTSTRAP_ADMIN_FIRST_NAME=مدیر
# BOOTSTRAP_ADMIN_LAST_NAME=سیستم
