<?xml version="1.0" encoding="utf-8"?>
<!--
  TECHA 2.0 — IIS REVERSE PROXY CONFIGURATION TEMPLATE
  Place this web.config in the root of the IIS website for techa.ir (or binding 62.220.123.21).
  Requires IIS URL Rewrite Module 2.1+ and Application Request Routing (ARR) 3.0+.
-->
<configuration>
  <system.webServer>
    <!-- Enable Reverse Proxy functionality via URL Rewrite & ARR -->
    <rewrite>
      <rules>
        <!-- 1. Enforce HTTPS (Redirect HTTP port 80 to HTTPS 443) -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. Route Public API v1 requests to Express Backend (Port 5000) -->
        <rule name="Reverse Proxy - Express API v1" stopProcessing="true">
          <match url="^api/v1/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5000/api/v1/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>

        <!-- 3. Route Swagger UI & OpenAPI Specification to Express Backend (Port 5000) -->
        <rule name="Reverse Proxy - Swagger UI and OpenAPI Spec" stopProcessing="true">
          <match url="^(api-docs|api-docs/.*|api-docs\.json)$" />
          <action type="Rewrite" url="http://127.0.0.1:5000/{R:0}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>

        <!-- 4. Route Public Backend Landing Page (/backend) to Express Backend Root -->
        <rule name="Reverse Proxy - Backend Landing Page" stopProcessing="true">
          <match url="^backend/?$" />
          <action type="Rewrite" url="http://127.0.0.1:5000/" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>

        <!-- 5. Route All Remaining Frontend Requests to Next.js 16 (Port 3000) -->
        <rule name="Reverse Proxy - Next.js Frontend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <!-- Security & Request Limits -->
    <security>
      <requestFiltering>
        <!-- Limit request payload to 10MB (matches Express limit) -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

    <!-- Custom HTTP Headers for Security -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
