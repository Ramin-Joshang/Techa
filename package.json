{
    "name":  "techa-monorepo",
    "version":  "2.0.0",
    "private":  true,
    "engines":  {
                    "node":  "\u003e=24.0.0 \u003c25",
                    "npm":  "\u003e=10.0.0"
                },
    "workspaces":  [
                       "shared",
                       "backend",
                       "frontend"
                   ],
    "overrides":  {
                      "react":  "^19.3.1",
                      "react-dom":  "^19.3.1",
                      "@types/react":  "^19.3.0",
                      "@types/react-dom":  "^19.3.0",
                      "dompurify":  "^3.4.17",
                      "sharp":  "^0.35.5",
                      "postcss-selector-parser":  "^6.1.6"
                  },
    "scripts":  {
                    "dev":  "concurrently -n \"shared,backend,frontend\" -c \"blue,green,magenta\" \"npm run dev --workspace=@techa/shared\" \"npm run dev --workspace=@techa/backend\" \"npm run dev --workspace=@techa/frontend\"",
                    "dev:backend":  "npm run dev --workspace=@techa/backend",
                    "dev:frontend":  "npm run dev --workspace=@techa/frontend",
                    "dev:shared":  "npm run dev --workspace=@techa/shared",
                    "db:provision":  "npm run db:provision --workspace=@techa/backend",
                    "db:inspect":  "npm run db:inspect --workspace=@techa/backend",
                    "seed":  "npm run seed --workspace=@techa/backend",
                    "build":  "npm run build --workspace=@techa/shared && npm run build --workspace=@techa/backend && npm run build --workspace=@techa/frontend",
                    "build:all":  "npm run build --workspace=@techa/shared \u0026\u0026 npm run build --workspace=@techa/backend \u0026\u0026 npm run build --workspace=@techa/frontend",
                    "build:shared":  "npm run build --workspace=@techa/shared",
                    "build:backend":  "npm run build --workspace=@techa/backend",
                    "build:frontend":  "npm run build --workspace=@techa/frontend",
                    "start":  "concurrently -n \"backend,frontend\" -c \"green,magenta\" \"npm run start:backend\" \"npm run start:frontend\"",
                    "start:backend":  "npm run start --workspace=@techa/backend",
                    "start:frontend":  "npm run start --workspace=@techa/frontend",
                    "pm2:start":  "pm2 start ecosystem.config.cjs --env production",
                    "pm2:restart":  "pm2 restart ecosystem.config.cjs --env production",
                    "pm2:stop":  "pm2 stop ecosystem.config.cjs",
                    "pm2:delete":  "pm2 delete ecosystem.config.cjs",
                    "pm2:status":  "pm2 status",
                    "pm2:logs":  "pm2 logs",
                    "pm2:save":  "pm2 save",
                    "typecheck":  "npm run typecheck --workspace=@techa/shared \u0026\u0026 npm run typecheck --workspace=@techa/backend \u0026\u0026 npm run typecheck --workspace=@techa/frontend",
                    "lint":  "npm run lint --workspaces --if-present",
                    "test":  "npm run test --workspace=@techa/backend \u0026\u0026 npm run test --workspace=@techa/frontend",
                    "test:backend":  "npm run test --workspace=@techa/backend",
                    "test:frontend":  "npm run test --workspace=@techa/frontend",
                    "verify":  "node scripts/verify-step1.cjs",
                    "verify:step2":  "node scripts/verify-step2.cjs",
                    "verify:step3":  "node scripts/verify-step3.cjs",
                    "verify:step4":  "node scripts/verify-step4.cjs",
                    "verify:step5":  "node scripts/verify-step5.cjs",
                    "verify:step6":  "node scripts/verify-step6.cjs",
                    "verify:step7":  "node scripts/verify-step7.cjs",
                    "verify:deployment":  "node scripts/verify-step7.cjs"
                },
    "devDependencies":  {
                            "concurrently":  "^9.1.2"
                        },
    "dependencies":  {
                         "@asteasolutions/zod-to-openapi":  "^9.1.0",
                         "@types/cssesc":  "^3.0.2",
                         "@types/swagger-ui-express":  "^4.1.8",
                         "cross-env":  "^10.1.0",
                         "cssesc":  "^3.0.0",
                         "pm2":  "^7.1.2",
                         "swagger-ui-express":  "^5.0.1"
                     }
}
