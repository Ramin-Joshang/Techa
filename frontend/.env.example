# ==============================================================================
# TECHA 2.0 — FRONTEND WORKSPACE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `frontend/.env.local` or rely on the root `.env` loaded via PM2.
# ==============================================================================

# Node runtime mode ('production' | 'development' | 'test')
NODE_ENV=production

# Internal TCP listener port for Next.js (default: 3000)
PORT=3000

# Internal network interface binding (default: 127.0.0.1 for loopback security)
HOST=127.0.0.1

# Server-side base URL for backend public API communication.
# Behind IIS, use loopback to call the local Express instance directly.
TECHA_API_BASE_URL=http://127.0.0.1:5000/api/v1/public
