# ==============================================================================
# TECHA 2.0 — FRONTEND NEXT.JS ENVIRONMENT TEMPLATE (frontend/.env.example)
# ==============================================================================
# برای اجرا روی سرور، این فایل را به frontend/.env یا frontend/.env.local کپی کنید.
# ==============================================================================

# --- Next.js Server Binding ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# --- Internal Backend Proxy & SSR API Endpoints ---
# آدرس داخلی سرور Express (Next.js درخواست‌های /api/* و SSR را به این آدرس هدایت می‌کند)
BACKEND_INTERNAL_URL=http://127.0.0.1:3500
TECHA_API_BASE_URL=http://127.0.0.1:3500/api/v1/public

# --- Public Client API & Canonical URL ---
# در حالت استفاده از Reverse Proxy / Next Rewrite این مقدار را خالی بگذارید تا کوکی‌های Same-Origin درست کار کنند
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://techa.ir

# --- Internal On-Demand Cache Revalidation ---
# باید دقیقاً برابر با مقدار CACHE_REVALIDATION_SECRET در بک‌اند باشد
CACHE_REVALIDATION_SECRET=replace_with_a_different_random_revalidation_secret_32_chars
