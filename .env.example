# ==============================================================================
# TECHA 2.0 — MONOREPO ROOT ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# راهنما:
# 1. این فایل را به نام .env در ریشه پروژه کپی کنید (یا از backend/.env و frontend/.env جداگانه استفاده کنید).
# 2. مقادیر نمونه و کلیدهای امنیتی را حتماً با مقادیر واقعی سرور خود جایگزین کنید.
# 3. هرگز فایل .env حاوی اطلاعات حساس را در مخزن گیت (Git) ذخیره نکنید.
# ==============================================================================

# --- Runtime Environment ---
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=true

# --- Backend Server (Express 5) ---
API_HOST=127.0.0.1
API_PORT=3500
CANONICAL_API_URL=https://techa.ir
FRONTEND_ORIGIN=https://techa.ir
CORS_ORIGINS=https://techa.ir,https://www.techa.ir,http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Server (Next.js 16) ---
HOST=127.0.0.1
PORT=3000
BACKEND_INTERNAL_URL=http://127.0.0.1:3500
TECHA_API_BASE_URL=http://127.0.0.1:3500/api/v1/public
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://techa.ir

# --- Database (MongoDB Atlas / MongoDB 7+) ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/techa_prod?retryWrites=true&w=majority

# --- Authentication & Cookies (JWT + Session) ---
# حداقل ۳۲ کاراکتر تصادفی و یکتا انتخاب کنید
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ISSUER=techa.ir
JWT_AUDIENCE=techa-platform
JWT_ACCESS_TTL_SECONDS=600
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# --- Cache Revalidation (Shared between Backend & Frontend) ---
FRONTEND_INTERNAL_URL=http://127.0.0.1:3000
CACHE_REVALIDATION_SECRET=replace_with_a_different_random_revalidation_secret_32_chars

# --- Kavenegar SMS OTP Service ---
# در صورت وارد کردن کلید API معتبر کاوه‌نگار، سرویس OTP به‌صورت خودکار فعال می‌شود
AUTH_OTP_ENABLED=true
KAVENEGAR_API_KEY=your_kavenegar_api_key_here
# الگوی پایه و الزامی تاییدشده در پنل کاوه‌نگار (در صورت نبود الگوی اختصاصی، از این الگو استفاده می‌شود)
KAVENEGAR_VERIFY_TEMPLATE=techa-otp
KAVENEGAR_REGISTER_TEMPLATE=techa-register
KAVENEGAR_LOGIN_TEMPLATE=techa-otp
KAVENEGAR_PASSWORD_RESET_TEMPLATE=techa-reset
# کلید امضای HMAC برای هش کدهای OTP (جدا از JWT و حداقل ۳۲ کاراکتر)
OTP_HASH_SECRET=replace_with_a_unique_otp_hmac_secret_at_least_32_characters
OTP_CODE_DIGITS=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=10

# --- Media Upload Limits ---
TECHA_MEDIA_STORAGE_ROOT=./storage/media
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_DOCUMENT_BYTES=52428800
MEDIA_MAX_VIDEO_BYTES=209715200
