# ==============================================================================
# TECHA 2.0 — CANONICAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This is the authoritative, documented environment inventory for the monorepo.
# Copy this file to `.env` in the project root and fill in the actual production values.
# NEVER commit real `.env` files or credentials into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Application Settings
# ------------------------------------------------------------------------------
# Runtime environment: 'production', 'development', or 'test'.
# In production, strict validation is enforced (e.g., MONGODB_URI is mandatory).
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Frontend Application Settings (Next.js 16)
# ------------------------------------------------------------------------------
# Internal TCP port where the Next.js standalone/SSR server will listen.
# Behind IIS, this port must remain private on loopback (127.0.0.1).
PORT=3000

# Internal network interface for the Next.js server.
# Set to 127.0.0.1 to prevent direct unencrypted exposure to the public network.
HOST=127.0.0.1

# Server-side base URL used by Next.js Server Components to fetch public API data.
# When running on the same server, use the private loopback address for maximum speed.
# Behind IIS, this calls Express directly on its private port.
TECHA_API_BASE_URL=http://127.0.0.1:5000/api/v1/public

# ------------------------------------------------------------------------------
# 3. Backend Application Settings (Express 5)
# ------------------------------------------------------------------------------
# Internal TCP port where the Express HTTP server will listen.
# Must be distinct from the frontend port. Keep private on loopback behind IIS.
API_PORT=5000

# Internal network interface for the Express server.
# Set to 127.0.0.1 for local IIS reverse-proxy upstream.
API_HOST=127.0.0.1

# Canonical public API origin for OpenAPI/Swagger documentation generation.
# Used in the Swagger server URL dropdown. Do NOT put internal loopback IPs here.
CANONICAL_API_URL=https://techa.ir

# Flag to enable Swagger UI and OpenAPI documentation endpoints (/api-docs, /api-docs.json).
# Set to 'true' or 'false'.
SWAGGER_ENABLED=true

# ------------------------------------------------------------------------------
# 4. MongoDB Settings (Mongoose 9 / MongoDB Atlas)
# ------------------------------------------------------------------------------
# Production MongoDB Atlas connection URI.
# Strictly required when NODE_ENV=production.
# Replace with your actual Atlas cluster credentials, database name, and options.
# Example format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/techa_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://techa_user:REPLACE_WITH_STRONG_PASSWORD@cluster0.abcde.mongodb.net/techa_production?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 5. Domain, Hostname & Reverse Proxy Settings
# ------------------------------------------------------------------------------
# Primary canonical production domain name.
PRODUCTION_DOMAIN=techa.ir

# Public static IPv4 address of the production Windows Server 2025 host.
PRODUCTION_IP=62.220.123.21

# Comma-separated list of allowed browser Origins for Cross-Origin Resource Sharing (CORS).
# Under the recommended IIS architecture, browser calls to /api are same-origin (https://techa.ir).
# Include development origins if testing frontend dev server against this backend.
CORS_ORIGINS=https://techa.ir,https://www.techa.ir,http://localhost:3000,http://127.0.0.1:3000

# Primary frontend origin used for server-to-server validation.
FRONTEND_ORIGIN=https://techa.ir

# Trusted reverse proxy configuration for Express (behind IIS / ARR).
# Set to '1' (or 'loopback') to trust the single reverse-proxy hop from IIS on localhost.
TRUST_PROXY_HOPS=1

# ------------------------------------------------------------------------------
# 6. Logging and Operational Settings
# ------------------------------------------------------------------------------
# Minimum log level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'.
LOG_LEVEL=info