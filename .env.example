# ==========================================
# TECHA 2.0 Environment Configuration
# ==========================================

# Backend API Environment
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=5000
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

# MongoDB Atlas Connection
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# or replica set URI: mongodb://<user>:<password>@<host1>:27017,<host2>:27017/?ssl=true&replicaSet=<name>&authSource=admin
MONGODB_URI=

# CORS & Networking
FRONTEND_ORIGIN=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Frontend Server-Side API Client (Server-Only, never exposed via NEXT_PUBLIC_)
TECHA_API_BASE_URL=http://127.0.0.1:5000/api/v1/public

# Legacy/Client-Side API Base URL
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5000/api/v1